# arc-agent-pay — SDK environment configuration
# Copy this file to `.env` for local development. `.env` is gitignored.
#
# SECURITY: never commit `.env`. Use dedicated, low-balance Arc Testnet keys.

# --- Chain ---
# Arc Testnet (chain ID 5042002). Keep true unless explicitly targeting another env.
ARC_TESTNET=true
# ARC_TESTNET_RPC=https://rpc.testnet.arc.network

# Optional service-discovery catalog. When set, ServiceRegistry syncs this HTTP JSON
# catalog ({"services":[...]}) and caches it locally; built-in services are fallback.
# ARC_REGISTRY_CATALOG_URL=https://your-catalog.example.com/services.json
# ARC_REGISTRY_CACHE_PATH=~/.cache/arc-agent-pay/service-catalog.json

# --- Agent wallet (payer) ---
# Signs EIP-3009 payment authorizations locally.
AGENT_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY

# Optional session spend ceiling for the MCP server.
# ARC_AGENT_PAY_BUDGET=0.50

# --- ERC-8004 identity / reputation / validation ---
# Defaults are built in for Arc Testnet; override only if using custom deployments.
# ERC8004_IDENTITY_REGISTRY=0x...
# ERC8004_REPUTATION_REGISTRY=0x...
# ERC8004_VALIDATION_REGISTRY=0x...
# AGENT_ID=1

# --- LLM synthesis (pick one provider, or none for template fallback) ---
# ArcAPIs on-chain inference:
# ARCAPIS_TOKEN_ID=pk_24
# ARCAPIS_ENDPOINT_ID=gpt5
# Optional signer override when packet owner key differs from AGENT_PRIVATE_KEY:
# ARCAPIS_SIGNER_KEY=0xOWNER_PRIVATE_KEY

# Or OpenAI directly:
# OPENAI_API_KEY=sk-proj-...

# --- Circle (optional) ---
# Only needed for Circle wallet / CLI funding helpers.
# CIRCLE_API_KEY=TEST_API_KEY:your_circle_test_api_key

# --- Observability (optional) ---
# Langfuse tracing is no-op when unset.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
